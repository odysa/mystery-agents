{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mystery-agents/openmystery/schema/openmystery-1.schema.json",
  "title": "OpenMystery 开放剧本杀格式 v1",
  "description": "一个剧本杀剧本 = 一个 JSON 文件。结构由本 Schema 约束；跨字段规则（引用、唯一凶手、依赖无环、可解性）由参考实现 src/engine/scenario.js 的 validateScenario 检查。",
  "type": "object",
  "required": [
    "id",
    "title",
    "background",
    "intro",
    "players",
    "victim",
    "locations",
    "characters",
    "clues",
    "truth",
    "config"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "openmystery/1",
      "description": "格式标识，建议填写"
    },
    "id": {
      "$ref": "#/$defs/id",
      "description": "全局唯一，与文件名一致"
    },
    "version": {
      "type": "string",
      "description": "剧本自己的版本号，如 1.0.0"
    },
    "title": {
      "type": "string",
      "maxLength": 40
    },
    "subtitle": {
      "type": "string",
      "maxLength": 200
    },
    "language": {
      "type": "string",
      "description": "BCP 47 语言标签，如 zh-CN"
    },
    "license": {
      "type": "string",
      "description": "剧本许可证，推荐 CC BY 4.0"
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "players": {
      "type": "integer",
      "minimum": 3,
      "maximum": 10,
      "description": "必须等于 characters 的数量"
    },
    "difficulty": {
      "enum": [
        "入门",
        "进阶",
        "困难"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 5
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20
      }
    },
    "background": {
      "type": "string",
      "description": "所有人可见的背景故事"
    },
    "intro": {
      "type": "string",
      "description": "主持人开场白"
    },
    "victim": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "bio": {
          "type": "string"
        },
        "portrait": {
          "$ref": "#/$defs/assetRef"
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 3,
      "description": "搜证地点。第一个视为案发现场",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "description": {
            "type": "string"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "image": {
            "$ref": "#/$defs/assetRef"
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "publicBio",
          "script",
          "objectives"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{3,8}$"
          },
          "publicBio": {
            "type": "string",
            "maxLength": 1000,
            "description": "所有人可见"
          },
          "personality": {
            "type": "string",
            "description": "给 AI 的表演提示"
          },
          "script": {
            "type": "string",
            "description": "只有该角色能看到的完整剧本"
          },
          "isMurderer": {
            "type": "boolean",
            "description": "恰好一名角色为 true"
          },
          "coverStory": {
            "type": "string",
            "description": "被质询时的标准说法"
          },
          "knowledge": {
            "type": "array",
            "description": "角色记得的事（证词）",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "text": {
                  "type": "string",
                  "maxLength": 1000
                },
                "time": {
                  "type": "string"
                },
                "implicates": {
                  "$ref": "#/$defs/weights"
                },
                "secret": {
                  "type": "boolean",
                  "description": "不愿主动说出"
                },
                "lie": {
                  "type": "boolean",
                  "description": "这是谎言"
                }
              }
            }
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type",
                "desc"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "find_murderer",
                    "escape",
                    "clue_public",
                    "clue_not_public",
                    "not_most_voted"
                  ]
                },
                "clue": {
                  "$ref": "#/$defs/id",
                  "description": "clue_public / clue_not_public 必填"
                },
                "desc": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          },
          "ruleHints": {
            "type": "object",
            "description": "给离线规则型 AI 的提示（可选）",
            "properties": {
              "preferredLocations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          },
          "portrait": {
            "$ref": "#/$defs/assetRef"
          },
          "voice": {
            "$ref": "#/$defs/voice"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/assetRef"
            },
            "description": "只有该角色可见的媒体"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "label"
        ],
        "properties": {
          "a": {
            "$ref": "#/$defs/id"
          },
          "b": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "public": {
            "type": "boolean",
            "description": "false 表示终局才揭晓"
          }
        }
      }
    },
    "victimRelationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "who",
          "label"
        ],
        "properties": {
          "who": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "clues": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "location",
          "title",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "location": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "time": {
            "type": "string",
            "pattern": "^$|^([01]\\d|2[0-3]):[0-5]\\d(-([01]\\d|2[0-3]):[0-5]\\d)?$"
          },
          "implicates": {
            "$ref": "#/$defs/weights",
            "description": "作者标注：指向谁、权重多少。永远不会发给玩家或 AI"
          },
          "requires": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "前置线索：搜证者持有或已公开后才能搜到"
          },
          "key": {
            "type": "boolean",
            "description": "关键线索（用于评测）"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/assetRef"
            },
            "description": "与线索同可见性的媒体"
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "description": "预埋矛盾：某条证词与某条线索冲突",
      "items": {
        "type": "object",
        "required": [
          "id",
          "knowledge",
          "clue",
          "text",
          "implicates"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "knowledge": {
            "$ref": "#/$defs/id"
          },
          "clue": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "implicates": {
            "$ref": "#/$defs/weights"
          }
        }
      }
    },
    "truth": {
      "type": "object",
      "required": [
        "murderer",
        "summary",
        "timeline"
      ],
      "properties": {
        "murderer": {
          "$ref": "#/$defs/id"
        },
        "weapon": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "time",
              "text"
            ],
            "properties": {
              "time": {
                "type": "string",
                "maxLength": 20
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "who",
              "text"
            ],
            "properties": {
              "who": {
                "$ref": "#/$defs/id"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "rounds"
      ],
      "properties": {
        "rounds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "investigate",
              "discuss"
            ],
            "properties": {
              "investigate": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "discuss": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            }
          }
        },
        "maxSpeechChars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 2000
        }
      }
    },
    "phaseNarration": {
      "type": "object",
      "description": "键为 investigate_1、discuss_1、…、vote",
      "additionalProperties": {
        "type": "string"
      }
    },
    "translations": {
      "type": "object",
      "description": "其他语言的翻译：{ 两位语言代码: 按 id 覆盖的文本字段 }，见规范 3.9",
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "assets": {
      "type": "object",
      "description": "媒体登记表，见规范 3.10",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "cover": {
      "$ref": "#/$defs/assetRef"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": -10,
        "maximum": 10
      }
    },
    "assetRef": {
      "$ref": "#/$defs/id",
      "description": "assets 里的媒体 id"
    },
    "asset": {
      "type": "object",
      "required": [
        "type",
        "src",
        "alt"
      ],
      "properties": {
        "type": {
          "enum": [
            "image",
            "audio"
          ]
        },
        "src": {
          "type": "string",
          "description": "media/… 相对路径、https 链接或 data URI"
        },
        "alt": {
          "type": "string",
          "maxLength": 500,
          "description": "文字描述（必填）"
        },
        "transcript": {
          "type": "string",
          "maxLength": 5000
        },
        "credit": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "voice": {
      "type": "object",
      "properties": {
        "gender": {
          "enum": [
            "female",
            "male",
            "neutral"
          ]
        },
        "age": {
          "enum": [
            "child",
            "young",
            "adult",
            "old"
          ]
        },
        "pitch": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "rate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "style": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}